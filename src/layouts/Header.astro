---
import Wrapper from "../components/shared/Wrapper.astro";
import MainLogo from "../components/Logos/MainLogo.astro";
import SuzyRounce from "../components/Logos/SuzyRounce.astro";
import SaveYourSeatOne from "../components/Icons/SaveYourSeatOne.astro";
import BookYourEvent from "../components/Icons/BookYourEvent.astro";

import "./header.scss";
import Headline from "../components/shared/Headline.astro";
---

<header class="main-header">
  <Wrapper classes="main-header-wrapper">
    <div class="main-header-left">
      <div class="main-header-left-logo">
        <h1>
          <a href="/">
            {
              Astro.url.pathname === "/" ? (
                <MainLogo />
              ) : Astro.url.pathname === "/speaking" ||
                Astro.url.pathname === "/speaking/" ? (
                <SuzyRounce />
              ) : (
                <MainLogo />
              )
            }
          </a>
          <span
            >{
              Astro.url.pathname === "/"
                ? "Marketing Compass Roadmap Workshops"
                : Astro.url.pathname === "/speaking"
                  ? "Suzy Rounce | Keynote Speaker"
                  : "Marketing Compass Roadmap Workshops"
            }
          </span>
        </h1>
      </div>
      <div class="main-header-left-sys-icon">
        {
          Astro.url.pathname === "/" ? (
            <SaveYourSeatOne />
          ) : Astro.url.pathname === "/speaking" ||
            Astro.url.pathname === "/speaking/" ? (
            <BookYourEvent />
          ) : (
            <MainLogo />
          )
        }
      </div>
    </div>
    <div class="main-header-right">
      <div class="main-header-right-title">
        <Headline
          ele="h2"
          hlstyle="one"
          set:html={Astro.url.pathname === "/"
            ? "Don’t be lost in the marketing<br /> wilderness any longer"
            : Astro.url.pathname === "/speaking"
              ? "Storytelling is a rally cry for<br /> building marketing success."
              : "Don’t be lost in the marketing<br /> wilderness any longer"}
        />
      </div>
    </div>
  </Wrapper>
</header>
